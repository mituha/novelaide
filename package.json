{
  "name": "novelaide",
  "private": true,
  "version": "0.46.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:plugin:fs": "npm run build --prefix tauri-plugin-novelaid-fs",
    "build:plugin:ai": "npm run build --prefix tauri-plugin-novelaid-ai",
    "build:plugin:git": "npm run build --prefix tauri-plugin-restar-git",
    "build:plugin:settings": "npm run build --prefix tauri-plugin-restar-settings",
    "build:plugin:calibration": "npm run build --prefix tauri-plugin-novelaid-calibration",
    "build:plugin:ruby": "npm run build --prefix tauri-plugin-novelaid-ruby",
    "build:plugin:metadata": "npm run build --prefix tauri-plugin-novelaid-metadata",
    "build:plugins": "npm run build:plugin:fs && npm run build:plugin:ai && npm run build:plugin:git && npm run build:plugin:settings && npm run build:plugin:calibration && npm run build:plugin:ruby && npm run build:plugin:metadata",
    "build:plugin": "npm run build:plugins",
    "typegen": "cargo test --manifest-path tauri-plugin-novelaid-fs/Cargo.toml && npm run build:plugin",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@gitgraph/js": "^1.4.0",
    "@gitgraph/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.61.0",
    "novelaid-markdown": "^0.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "restar-app": "^0.2.2",
    "restar-app-git": "file:tauri-plugin-restar-git",
    "restar-app-settings": "file:tauri-plugin-restar-settings",
    "tauri-plugin-novelaid-ai-api": "file:tauri-plugin-novelaid-ai",
    "tauri-plugin-novelaid-calibration-api": "file:tauri-plugin-novelaid-calibration",
    "tauri-plugin-novelaid-fs-api": "file:tauri-plugin-novelaid-fs",
    "tauri-plugin-novelaid-metadata-api": "file:tauri-plugin-novelaid-metadata",
    "tauri-plugin-novelaid-ruby-api": "file:tauri-plugin-novelaid-ruby"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
