{
  "name": "restar-app-settings",
  "version": "0.1.0",
  "author": "Mizuki Mituha",
  "description": "Plugable settings system and modal for Tauri applications",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js",
      "require": "./dist-js/index.cjs"
    },
    "./styles.css": "./dist-js/SettingsModal.css"
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && rollup -c",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^1.16.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rollup": "^4.9.6",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.3.3",
    "tslib": "^2.6.2"
  }
}
